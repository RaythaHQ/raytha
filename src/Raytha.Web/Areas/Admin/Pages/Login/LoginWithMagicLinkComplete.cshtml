@page "/raytha/login/magic-link/complete"
@model Raytha.Web.Areas.Admin.Pages.Login.LoginWithMagicLinkComplete

@{
    Layout = "EmptyLayout";
}

<section class="vh-lg-100 mt-5 mt-lg-0 bg-soft d-flex align-items-center">
    <div class="container">
        <div class="row justify-content-center form-bg-image">
            <div class="col-12 d-flex align-items-center justify-content-center">
                <div class="bg-white shadow border-0 rounded border-light p-4 p-lg-5 w-100 fmxw-500">
                    <div class="text-center text-md-center mb-4 mt-md-0">
                        <h1 class="mb-0 h3">Enter your one-time code</h1>
                        <p class="mt-2 mb-0 text-gray-600">We emailed a code to you. Enter it below to sign in.</p>
                    </div>
                    @if (ViewData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger mt-2">
                            @ViewData["ErrorMessage"]
                        </div>
                    }

                    <form method="post" asp-page="@RouteNames.Login.LoginWithMagicLinkComplete"
                        asp-route-returnUrl="@(ViewData["returnUrl"])" class="mt-4">
                        <div class="form-group mb-4">
                            <label for="email" asp-for="Form.EmailAddress"></label>
                            <div class="input-group">
                                <input type="email" class="form-control" asp-for="Form.EmailAddress">
                            </div>
                        </div>
                        <div class="form-group mb-4">
                            <label for="code" asp-for="Form.Code"></label>
                            <div class="input-group">
                                <input type="text" class="form-control" inputmode="numeric"
                                    autocomplete="one-time-code" asp-for="Form.Code" autofocus>
                            </div>
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-gray-800">Sign in</button>
                        </div>
                    </form>

                    <div class="d-flex justify-content-center align-items-center mt-4">
                        <span class="fw-normal">
                            Need a new code?
                            <a asp-page="@RouteNames.Login.LoginWithMagicLink"
                                asp-route-returnUrl="@(ViewData["returnUrl"])" class="fw-bold">Request another</a>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
