# Raytha Environment Variables
# Copy this file to .env and modify as needed
# Usage: docker-compose --env-file .env up

# =============================================================================
# ENVIRONMENT MODE
# =============================================================================
# Set to Development to disable HTTPS enforcement (required for non-localhost HTTP)
# Set to Production for production deployments with HTTPS
ASPNETCORE_ENVIRONMENT=Development

# =============================================================================
# DATABASE
# =============================================================================
# Postgres connection string (required)
# ConnectionStrings__DefaultConnection=Host=db;Port=5432;Username=postgres;Password=changeme;Database=raytha

# =============================================================================
# PATH BASE
# =============================================================================
# Set if running Raytha at a subpath (e.g., mydomain.com/mywebsite)
# PATHBASE=/mywebsite

# =============================================================================
# REVERSE PROXY TRUST
# =============================================================================
# !!! If Kestrel is reachable directly from the internet, set TRUSTED_PROXIES=none
# !!! (or list your proxies). The default trusts ANY peer, so a client that can
# !!! reach Raytha directly can forge its IP address and bypass per-IP rate limits.
#
# Raytha reads the client IP and scheme from X-Forwarded-For and
# X-Forwarded-Proto sent by the peers you trust here. X-Forwarded-Host is never
# honored. Links in emails come from the Website URL in organization settings.
#
# TRUSTED_PROXIES   all (default when unset), none, private, or a comma-separated
#                   list of IP addresses and CIDR ranges (private may be mixed in).
#                   all and none must be the only value. Startup fails on an
#                   entry it cannot read.
# TRUSTED_PROXY_HOPS  With all only: how many proxies append to X-Forwarded-For
#                   (default 1). Lists follow the chain until the first untrusted
#                   address, so they take no hop count.
#
# Railway, Azure App Service, a single nginx or Caddy on the same host, or
# Cloudflare in front of a VM whose firewall only admits Cloudflare:
# TRUSTED_PROXIES=all
#
# Cloudflare in front of Railway or Azure App Service (two proxies append):
# TRUSTED_PROXIES=all
# TRUSTED_PROXY_HOPS=2
#
# Docker networks, a sidecar proxy, or a tunnel such as cloudflared (private
# covers 10/8, 172.16/12, 192.168/16, 100.64/10, loopback, link-local, fc00::/7):
# TRUSTED_PROXIES=private
#
# Known proxy addresses (IPv4 or IPv6):
# TRUSTED_PROXIES=10.20.0.0/16,203.0.113.10,2001:db8::/32
#
# Kestrel exposed directly to the internet with no proxy in front:
# TRUSTED_PROXIES=none

# =============================================================================
# SMTP / EMAIL SETTINGS
# =============================================================================
# Required for password reset, email notifications, etc.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_NAME=
# SMTP_FROM_ADDRESS=

# =============================================================================
# FILE STORAGE
# =============================================================================
# FILE_STORAGE_PROVIDER=Local
# Options: Local, AzureBlob, S3

# FILE_STORAGE_MAX_FILE_SIZE=20000000
# Max file size in bytes (default: 20 MB)

# FILE_STORAGE_MAX_TOTAL_DISK_SPACE=1000000000
# Max total storage in bytes (default: 1 GB)

# FILE_STORAGE_ALLOWED_MIMETYPES=text/*,image/*,video/*,audio/*,application/pdf
# Comma-separated mime types, wildcards supported

# FILE_STORAGE_USE_DIRECT_UPLOAD_TO_CLOUD=true
# Recommended true for S3/AzureBlob (requires CORS config on buckets)

# --- Local Storage ---
# FILE_STORAGE_LOCAL_DIRECTORY=user-uploads

# --- Azure Blob Storage ---
# FILE_STORAGE_AZUREBLOB_CONNECTION_STRING=
# FILE_STORAGE_AZUREBLOB_CONTAINER=
# FILE_STORAGE_AZUREBLOB_CUSTOM_DOMAIN=

# --- S3 / S3-Compatible Storage ---
# FILE_STORAGE_S3_ACCESS_KEY=
# FILE_STORAGE_S3_SECRET_KEY=
# FILE_STORAGE_S3_BUCKET=
# FILE_STORAGE_S3_SERVICE_URL=
# Required for S3-compatible providers (MinIO, Cloudflare R2), not AWS S3
# FILE_STORAGE_S3_REGION=us-east-1
# Required for AWS S3

# =============================================================================
# DATABASE LIMITS
# =============================================================================
# DATABASE_MAX_SIZE=1000000000
# Max database size in bytes (default: 1 GB)

# =============================================================================
# BACKGROUND WORKERS
# =============================================================================
# NUM_BACKGROUND_WORKERS=4

# =============================================================================
# RAYTHA FUNCTIONS
# =============================================================================
# RAYTHA_FUNCTIONS_MAX_ACTIVE=5
# RAYTHA_FUNCTIONS_TIMEOUT=10000
# RAYTHA_FUNCTIONS_QUEUE_TIMEOUT=10000

# =============================================================================
# MAINTENANCE / REDIRECT
# =============================================================================
# REDIRECT_WEBSITE=
# Set a URL to redirect all visitors (useful for maintenance)

# =============================================================================
# MIGRATIONS
# =============================================================================
# APPLY_PENDING_MIGRATIONS=true
# Automatically apply database migrations on startup

# =============================================================================
# SECURITY
# =============================================================================
# ENFORCE_HTTPS=true
# Enforce HTTPS redirection and HSTS in non-development environments
# Automatically disabled when ASPNETCORE_ENVIRONMENT=Development

# ALLOW_INTERNAL_URL_IMPORTS=false
# Allow server-side requests to localhost and internal IPs: theme and CSV imports,
# webhook deliveries, and Raytha Functions HTTP calls.
# Set true only when those must reach internal services, such as another container.

# IMPERSONATION_MAX_MINUTES=60
# Hard limit on an admin impersonation session, in minutes (1-1440)

# AUTH_RATE_LIMIT_PER_MINUTE=30
# Sign-in, password-reset and magic-link requests allowed per client IP per minute

# =============================================================================
# ADMIN SPA (local development only)
# =============================================================================
# In Development, Raytha starts and proxies the admin's Vite dev server. The Docker
# image ships only the built admin bundle, so it sets AdminSpa__AutoStart=false.
# AdminSpa__DevServerUrl=http://localhost:5203
# AdminSpa__AutoStart=true
# ASPNETCORE_URLS=http://0.0.0.0:5200

# =============================================================================
# OBSERVABILITY (optional)
# =============================================================================
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_PROTOCOL=
# Set to grpc for gRPC; anything else is HTTP/protobuf
# OTEL_SERVICE_NAME=raytha
# OBSERVABILITY_LOGGING_ENABLE_CONSOLE=true
# OBSERVABILITY_LOGGING_ENABLE_LOKI=false
# LOKI_URL=
# LOKI_USERNAME=
# LOKI_PASSWORD=
